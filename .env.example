# =============================================================================
# Samruddhi QMS — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed — it holds the DB password.
# Real environment variables take precedence over anything set here.
#
# ⚠ THIS FILE IS TRACKED IN GIT. Never put a real password, key or connection
#   string in it. Every value here is either a safe local-dev default or blank.
#
# docs/ENVIRONMENT.md is the full list — every variable the application reads,
# what it defaults to, and which ones are mandatory in production.

# ── MySQL ────────────────────────────────────────────────────────────────────
# DB_ENABLED=false runs the app entirely in memory (data lost on restart).
DB_ENABLED=true

# DB_STRICT=true refuses to start when MySQL is unreachable, instead of quietly
# falling back to in-memory. Turn this on once you rely on the data.
DB_STRICT=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=samruddhi_qms
DB_USER=root
DB_PASSWORD=

# ── Flask ────────────────────────────────────────────────────────────────────
# Signs the session cookie. LEAVE IT BLANK HERE and set it in `.env` only.
#
# ⚠ This line used to read `SECRET_KEY=qms-demo-secret-2024`, and that was a
#   hole rather than a convenience. That literal is published in this
#   repository's history, it signs any cookie an attacker cares to mint, and
#   ABOUT.md §7 gap 8 is the record of it being deleted from the code. Anyone
#   who ran the `cp .env.example .env` step got it back — and silently, because
#   `auth.secret_key_warning()` only fires when NOBODY supplied a key, and a
#   published placeholder looks exactly like a real one from inside the process.
#
# Blank means "not supplied", which is the path that works and says so: the app
# falls through to `secret_key.txt` beside the code, mints a real random 256-bit
# key if that is absent, and prints a loud startup banner telling you it did.
# Generate your own for a deployment:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Bind address (the dev server in app.py; gunicorn takes its own) ──────────
# SAMRUDDHI_HOST / SAMRUDDHI_PORT, or the bare HOST / PORT if your host sets
# those. 127.0.0.1 is deliberate: `python app.py` runs Werkzeug with debug on,
# which must never listen on a public interface. Use wsgi.py in production.
SAMRUDDHI_HOST=127.0.0.1
SAMRUDDHI_PORT=5000

# ── Attachment store (CC-2 B8 — the files live on disk, not in MySQL) ───────
# Blank means `<repo>/attachments`. On a real server put it OUTSIDE the
# checkout, so a redeploy cannot delete the client's uploaded files.
# ⚠ A backup of this application is the database AND this directory together —
#   tools/backup_db.py writes both halves under one stamp.
ATTACHMENT_DIR=

# ── Session cookie flags ─────────────────────────────────────────────────────
# The defaults here are the LOCAL-DEV values. SESSION_COOKIE_SECURE=false is
# required for http://127.0.0.1 — a Secure cookie is never sent over plain HTTP,
# so a browser silently drops it and nobody can sign in.
#
# ⚠ SESSION_COOKIE_SECURE=true IS MANDATORY IN PRODUCTION. Without it the
#   session token that `auth.enforce()` trusts travels in clear.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ── Single worker, enforced ───────────────────────────────────────────────────
# STORE is one dict in ONE process's RAM. Two workers = two divergent copies of
# the whole application state, overwriting each other with no error at all.
# wsgi.py refuses to start under a second worker. This is the override, and it
# exists only so the refusal can be tested — never set it on a real server.
# SAMRUDDHI_ALLOW_MULTIPROCESS=
